{
  "domain": [
    "home-assistant.io",
    "/deploy-preview-\\d+--home-assistant-docs\\.netlify\\.app/"
  ],
  "colors": {
    "background": "#ffffff",
    "text": "#1D2126",
    "subtitle": "#A1A1A1"
  },
  "remoteAssets": {
    "logo": "https://brands.openhomefoundation.org/api/home-assistant/logo/screen/lockup/main/color/light/png"
  },
  "routes": [
    {
      "path": "/blog/*",
      "layout": "blog"
    },
    {
      "path": "/integrations/*",
      "layout": "integration"
    },
    {
      "path": "*",
      "layout": "default"
    }
  ]
}